.glass{background:linear-gradient(145deg,rgba(22,32,57,.94),rgba(12,18,35,.97));border:1px solid rgba(234,179,8,.14);box-shadow:0 12px 35px #0003}
.gold{color:var(--gold)}.btn{border:1px solid #33415f;background:#18233e;padding:.65rem .9rem;border-radius:.75rem;font-weight:650;transition:.2s;cursor:pointer}.btn:hover{border-color:var(--gold);transform:translateY(-1px)}.btn-primary{background:var(--gold);color:#111827;border-color:var(--gold)}.btn-danger{border-color:#7f1d1d;color:#fecaca;background:#35151f}.navbtn{padding:.75rem .85rem;border-radius:.75rem;color:#b7c2d9;white-space:nowrap;cursor:pointer}.navbtn.active,.navbtn:hover{background:#26314b;color:#fff}.navbtn.active{box-shadow:inset 0 -2px var(--gold)}.field{width:100%;background:#090f20;border:1px solid #34415d;border-radius:.65rem;padding:.7rem .8rem;color:#fff;outline:none}.field:focus{border-color:var(--gold)}.field option{background:#10172b}.label{display:block;font-size:.78rem;color:#b5c0d5;margin:0 0 .35rem}.table-wrap{overflow-x:auto}table{width:100%;border-collapse:collapse;min-width:680px}th{font-size:.72rem;letter-spacing:.07em;text-transform:uppercase;color:#aebbd4;text-align:left;padding:.85rem .7rem;background:#0c1326}td{padding:.8rem .7rem;border-bottom:1px solid #27324a;font-size:.9rem}tbody tr:hover{background:#ffffff06}.badge{font-size:.7rem;padding:.25rem .5rem;border-radius:999px;background:#273450;color:#dce5f8}.team-icon{width:42px;height:42px;display:grid;place-items:center;border-radius:13px;background:linear-gradient(135deg,#243458,#111a30);border:1px solid #394968;font-size:1.25rem}.statnum{font-size:1.7rem;font-weight:800;letter-spacing:-.04em}.hidden{display:none!important}.modal-bg{position:fixed;inset:0;background:#02040bd9;display:grid;place-items:center;padding:1rem;z-index:50}.modal{width:min(720px,100%);max-height:90vh;overflow:auto}.toast{position:fixed;bottom:1rem;right:1rem;background:#16243d;border:1px solid #eab30888;padding:.8rem 1rem;border-radius:1rem;z-index:80;box-shadow:0 12px 30px #0008}.hero-orb{position:absolute;border:1px solid #eab30830;border-radius:50%;width:340px;height:340px;right:-100px;top:-150px;pointer-events:none}.smallmuted{font-size:.8rem;color:var(--muted)}.news-img{width:100%;height:180px;object-fit:contain;background:#0b1120;cursor:pointer;transition:.2s;padding:4px}.news-img:hover{opacity:.9}.pill{border:1px solid #34415d;border-radius:999px;padding:.35rem .7rem;color:#cbd5e1;font-size:.8rem}
</style>
